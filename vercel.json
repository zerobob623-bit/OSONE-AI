{
  "version": 2,
  "buildCommand": "npm run build:vercel && node scripts/conferir-build-vercel.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/billing/:path*",
      "destination": "/api/billing"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/)[^.]*)",
      "destination": "/index.html"
    }
  ]
}
