# Freesound API Key (freesound.org/apiv2/apply)
FREESOUND_API_KEY=

# Gemini API Key (Managed by system, but declared for documentation)
GEMINI_API_KEY=

# ElevenLabs Configuration (Optional Global Backend keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Custom Search API Configuration (for live web searching locally)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Tavily AI Search API Configuration
TAVILY_API_KEY=

# Firebase Client Configuration (Fallback / Overrides for production deployments like Vercel / GitHub Actions)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# URL pública do backend de cobrança. No site pode ficar vazia para usar a mesma origem;
# no app Electron, aponte para o domínio HTTPS onde /api/billing está hospedado.
VITE_OSONE_BILLING_URL=

# Stripe Billing (somente no backend hospedado — nunca use prefixo VITE_ nestas chaves)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
OSONE_BILLING_RETURN_URL=
# Origens web autorizadas, separadas por vírgula. localhost/127.0.0.1 já são aceitos para Electron.
OSONE_BILLING_ALLOWED_ORIGINS=

# Firebase Admin (somente backend). Prefira um secret JSON em uma única linha.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Tuya IoT Cloud API Configuration (Server-Side Only)
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_USER_UID=

# OSONE ZAP (WhatsApp) — required only if you access the WhatsApp panel from
# somewhere other than the machine running the server (e.g. a tunnel). Local
# access from the same machine (127.0.0.1) always works without this.
WHATSAPP_ACCESS_TOKEN=

# Google Home (Actions on Google Smart Home Action) — the client_id/secret you register in
# your own Actions on Google Console project. This bridges Google Assistant/Google Home to
# your real Tuya devices. Requires the server to be reachable at a public HTTPS URL (Google
# does not accept localhost); see the Settings > Google Home panel for the exact URLs to paste.
GOOGLE_HOME_CLIENT_ID=
GOOGLE_HOME_CLIENT_SECRET=
