node_modules
dist
dist-desktop
server-build
# Voz local (Piper): ~90 MB de binário e modelo, baixados por "npm run baixar-voz".
# Ficam fora do repositório e entram no instalador durante a publicação.
vendor
.env
.env.local
.env.*.local
.baileys_auth
.wwebjs_auth/
.wwebjs_cache/
generated-content/
firebase-applet-config.json

# OSONE ZAP (WhatsApp) local data — contains customer PII, never commit
contacts.json
conversations.json
knowledge-base.json
# Guarda as escolhas do painel do OSONE ZAP, incluindo chaves de API (Gemini/ElevenLabs)
whatsapp-config.json

# OSONE Local Agent — config.json holds the auto-generated bearer token that guards
# app-opening/volume/terminal access to this machine; audit.log/trash are local runtime data
config.json
audit.log
trash/

# Google Home OAuth account-linking tokens
google-home-tokens.json

# Credenciais da casa inteligente preenchidas pela tela de Configuracoes (Tuya/Google Home).
# Contem o Access Secret que assina as requisicoes da Tuya — nunca commitar.
credenciais-osone.json

# Credenciais privadas usadas para assinar o APK. A mesma chave precisa assinar todas as
# versoes Android, mas nunca pode entrar no repositorio.
.secrets/

# O projeto Android passou a conter serviços nativos de Acessibilidade e MediaProjection e não
# pode mais ser recriado pelo Bubblewrap (isso apagaria esses serviços). Versionamos o fonte e
# ignoramos somente build, cache, configuração local e material privado de assinatura.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.jks
