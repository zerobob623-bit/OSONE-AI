rules_version = '2';

// Regras de segurança do Firestore para o OSONE. Sem isto, um projeto Firebase novo fica em
// "modo de teste" por padrão — qualquer pessoa na internet, autenticada ou não, pode ler e
// escrever em QUALQUER documento do banco (inclusive os dados de outros usuários). Como o
// OSONE vai ser distribuído publicamente, isso é obrigatório, não opcional.
//
// Regra: cada usuário autenticado só pode ler/escrever o PRÓPRIO documento
// (users/{seu-uid}), nunca o de outra pessoa. Ninguém não-autenticado tem acesso a nada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Direitos de assinatura são escritos exclusivamente pelo backend via Admin SDK.
    // O assinante pode consultar o próprio plano, mas nunca promover a si mesmo.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /billingCustomers/{document=**} {
      allow read, write: if false;
    }

    match /billingEvents/{document=**} {
      allow read, write: if false;
    }

    match /billingPurchases/{document=**} {
      allow read, write: if false;
    }

    // Um documento por versão: o usuário autenticado pode registrar o próprio aceite uma vez.
    // acceptedAt precisa ser o horário do servidor; alteração e exclusão ficam proibidas.
    match /legalAcceptances/{userId}/versions/{version} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'version', 'termsVersion', 'privacyVersion', 'acceptedAt'
        ])
        && request.resource.data.version == version
        && request.resource.data.termsVersion == version
        && request.resource.data.privacyVersion == version
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    // Nega tudo o mais por padrão (comportamento implícito do Firestore quando nenhuma regra
    // casa, mas deixamos explícito aqui para não haver dúvida).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
